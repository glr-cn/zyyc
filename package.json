{
  "name": "light-erp",
  "version": "0.1.0",
  "private": true,
  "description": "佐雍云仓数据中心（仓储/发货服务企业）",
  "scripts": {
    "start": "NODE_ENV=production node src/server.js",
    "dev": "nodemon --config nodemon.json src/server.js",
    "dev:live": "nodemon --config nodemon.json src/server.js",
    "test": "node --test tests/",
    "migrate:logs": "node scripts/migrate_audit_logs.js",
    "verify:data": "node scripts/verify_data_integrity.js"
  },
  "dependencies": {
    "apicache": "^1.6.3",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.5",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.5.3",
    "morgan": "^1.12.1",
    "multer": "^2.0.0",
    "node-sqlite3-wasm": "^0.8.61",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  },
  "comment": "数据库驱动双运行时：Node 22+ 用内置 node:sqlite；Node 20（部署运行时无该内置模块）自动回退 node-sqlite3-wasm。建表 SQL 与业务 SQL 完全一致（见 src/db/driver.js）。",
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
